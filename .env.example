APIFY_API_TOKEN=

# Tavily or Exa API Key for scraping economic news
TAVILY_API_KEY=your_tavily_key_here
EXA_API_KEY=your_exa_key_here

# Database Configuration (if required)
DB_PATH=sqlite:///macro_trading.db
